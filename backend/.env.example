APP_ENV=development
PORT=8080

DATABASE_URL=postgres://fatura:fatura@localhost:5432/fatura?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

JWT_SECRET=change-me-to-a-32-byte-minimum-random-secret
ACCESS_TOKEN_TTL=24h

# En az biri zorunludur. Apple Developer üyeliği yıllık ücretli olduğu için
# Apple boş bırakılabilir; o zaman /auth/apple 404 döner.
GOOGLE_CLIENT_IDS=000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
APPLE_CLIENT_IDS=

ALLOWED_ORIGINS=http://localhost:8081

REQUEST_TIMEOUT=15s
READ_HEADER_TIMEOUT=5s
SHUTDOWN_TIMEOUT=15s

# --- Fiş okuma (ADIM 2) -------------------------------------------------
# AI_PROVIDER: gemini | openai
AI_PROVIDER=gemini

# Google AI Studio'dan alınan anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# AI_PROVIDER=openai ise gerekir: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Görsel boyutu / AI çağrısı zaman aşımı
MAX_SCAN_IMAGE_BYTES=8388608
SCAN_TIMEOUT=45s

# Hız limitleri (0 = kapalı)
RATE_LIMIT_PER_MINUTE=120
SCAN_DAILY_LIMIT=50