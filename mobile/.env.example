# API adresi
# - iOS simülatörde localhost doğrudan çalışır
# - Fiziksel telefonda (Expo Go) bilgisayarınızın LAN adresini yazın:
#   macOS'ta: ipconfig getifaddr en0
EXPO_PUBLIC_API_URL=http://localhost:8080

# Google girişi — Google Cloud Console > OAuth 2.0 Client ID (Web türü)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Zaman aşımları (ms)
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=15000
EXPO_PUBLIC_AUTH_TIMEOUT_MS=20000
# Yapay zekâ çağrısı yavaş olabilir; backend SCAN_TIMEOUT (45s) ile uyumlu olmalı
EXPO_PUBLIC_SCAN_TIMEOUT_MS=60000

# AI'a gönderilmeden önce görselin küçültüleceği maksimum genişlik (px)
EXPO_PUBLIC_MAX_SCAN_WIDTH=1600
