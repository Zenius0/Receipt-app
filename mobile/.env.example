# API adresi
# Backend Render'da çalışıyorsa (önerilen) doğrudan servis adresini yazın:
EXPO_PUBLIC_API_URL=https://receipt-app-udje.onrender.com
#
# Backend'i bilgisayarınızda çalıştırıyorsanız:
# - iOS simülatör / web  -> http://localhost:8080
# - Fiziksel telefon     -> bilgisayarınızın LAN adresi
#   macOS'ta: ipconfig getifaddr en0

# Google girişi — Google Cloud Console > OAuth 2.0 Client ID (Web türü)
# NOT: Bu değer backend'deki GOOGLE_CLIENT_IDS ile aynı olmalı.
# NOT: Google girişi bir native modül kullanır, Expo Go içinde çalışmaz.
#       Denemek için geliştirme derlemesi kurun (README'deki ADIM'a bakın).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Zaman aşımları (ms)
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=15000
EXPO_PUBLIC_AUTH_TIMEOUT_MS=20000
# Yapay zekâ çağrısı yavaş olabilir; backend SCAN_TIMEOUT (45s) ile uyumlu olmalı
EXPO_PUBLIC_SCAN_TIMEOUT_MS=60000

# AI'a gönderilmeden önce görselin küçültüleceği maksimum genişlik (px)
EXPO_PUBLIC_MAX_SCAN_WIDTH=1600
