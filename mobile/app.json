{
  "expo": {
    "name": "Fatura Takipçi",
    "slug": "receipt-app",
    "scheme": "fatura",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.selim.fatura",
      "infoPlist": {
        "NSCameraUsageDescription": "Fiş fotoğrafı çekmek için kamera erişimi gerekir.",
        "NSPhotoLibraryUsageDescription": "Galeriden fiş fotoğrafı seçmek için erişim gerekir."
      }
    },
    "android": {
      "package": "com.selim.fatura",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Galeriden fiş fotoğrafı seçmek için erişim gerekir.",
          "cameraPermission": "Fiş fotoğrafı çekmek için kamera erişimi gerekir."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Giriş bilgilerinizi güvenle saklamak için Face ID kullanılır."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.4147052520-a6q3qj7v3fo9sa3cl4m39gbjjtbsft7k"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "61075912-d9b9-4421-9f99-9b839b6d1eb7"
      }
    }
  }
}
